{
  "manifest_version": 3,
  "name": "收藏到 Paul 素材库",
  "version": "1.4.0",
  "description": "左键拖图，或从右键菜单收藏图片和视频帧到 Paul 素材库。",
  "key": "",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [{
    "matches": ["https://*/*", "http://*/*"],
    "js": ["video-frame.js", "video-drag.js", "drag.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "background": { "service_worker": "worker.js" },
  "action": { "default_title": "收藏到 Paul 素材库", "default_popup": "capture.html" }
}
