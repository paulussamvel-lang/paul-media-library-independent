{
  "manifest_version": 3,
  "name": "收藏到 Paul 素材库",
  "version": "1.0.0",
  "description": "右击网页图片，保存原图和来源到本机 Paul 素材库。",
  "key": "",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_title": "收藏到 Paul 素材库", "default_popup": "capture.html" }
}
